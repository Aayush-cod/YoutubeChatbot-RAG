{
  "manifest_version": 3,
  "name": "YouTube RAG Assistant",
  "version": "0.1.0",
  "description": "Summarize a YouTube video and chat with it.",
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content.js"],
      "css": ["sidebar.css"],
      "run_at": "document_idle"
    }
  ]
}