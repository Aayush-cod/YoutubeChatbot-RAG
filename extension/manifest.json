{
  "manifest_version": 3,
  "name": "YouTube RAG Assistant",
  "version": "1.0.0",
  "description": "Summarize a YouTube video and ask questions about it, with answers linked to timestamps.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "host_permissions": ["https://16-178-109-110.sslip.io/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["transcript.js", "api.js", "content.js"],
      "css": ["sidebar.css"],
      "run_at": "document_idle"
    }
  ]
}